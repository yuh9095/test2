project('dinit-logind','c',version:'0.1.0',meson_version:'>= 0.60.0',
  default_options:['c_std=c11','warning_level=3','werror=true'])
udev_dep=dependency('libudev')
cc=meson.get_compiler('c')
pam_lib=cc.find_library('pam',required:false)
pam_header=cc.has_header('security/pam_modules.h')
core_lib=static_library('dinit-logind-core',files('src/core/manager.c'),
  include_directories:include_directories('src'),install:false)
core_dep=declare_dependency(link_with:core_lib,include_directories:include_directories('src'))
session_lib=static_library('dinit-logind-session-registration',
  files('src/session/registration.c','src/session/socket.c'),
  dependencies:core_dep,include_directories:include_directories('src'),install:false)
session_dep=declare_dependency(link_with:session_lib,dependencies:core_dep,
  include_directories:include_directories('src'))
platform_lib=static_library('dinit-logind-linux-platform',
  files('src/platform/linux/udev.c','src/platform/linux/udev-manager.c','src/platform/linux/vt.c'),
  dependencies:udev_dep,include_directories:include_directories('src'),install:false)
platform_dep=declare_dependency(link_with:platform_lib,dependencies:[udev_dep,core_dep],
  include_directories:include_directories('src'))
daemon=executable('dinit-logind','src/daemon/main.c',
  dependencies:[platform_dep,session_dep],install:true)
if pam_lib.found() and pam_header
  shared_module('pam_dinit_logind','src/pam/pam_dinit_logind.c',
    dependencies:pam_lib,include_directories:include_directories('src'),
    name_prefix:'',install:true,install_dir:join_paths(get_option('libdir'),'security'))
endif
test('daemon-help',daemon,args:['--help'],timeout:10)
test('daemon-version',daemon,args:['--version'],timeout:10)
core_test=executable('test-core','tests/test-core.c',dependencies:core_dep)
test('core-model',core_test,timeout:30)
reg_test=executable('test-session-registration','tests/test-session-registration.c',dependencies:session_dep)
test('session-registration',reg_test,timeout:30)
sock_test=executable('test-session-socket','tests/test-session-socket.c',dependencies:session_dep)
test('session-socket',sock_test,timeout:30)
plat_test=executable('test-linux-platform','tests/test-linux-platform.c',dependencies:platform_dep)
test('linux-platform-api',plat_test,timeout:30)
udev_test=executable('test-udev-manager','tests/test-udev-manager.c',dependencies:platform_dep)
test('udev-manager-integration',udev_test,timeout:30)
